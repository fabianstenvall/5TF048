@model List<FilmLogg.Models.Movie>

@{
    ViewData["Title"] = "Filmer";
}

<h1>Filmer</h1>

@{
    string? lastSearch = ViewBag.LastSearch;
}

<form method="get" asp-action="Index" class="mb-3">
    <div class="input-group">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Sök på titel" />
        <button type="submit" class="btn btn-primary">Sök</button>
    </div>
</form>

@if (!string.IsNullOrEmpty(lastSearch))
{
    <p>Din förra sökning: <a asp-action="Index" asp-route-search="@lastSearch">@lastSearch</a></p>
}

<p>Antal filmer: @Model.Count, total speltid: @ViewBag.TotalRuntime minuter</p>

<table class="table">
    <thead>
        <tr>
            <th>Titel</th>
            <th>År</th>
            <th>Speltid (min)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var movie in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@movie.Id">@movie.Title</a></td>
                <td>@movie.ReleaseYear</td>
                <td>@movie.RuntimeMinutes</td>
            </tr>
        }
    </tbody>
</table>