@model List<FilmLogg.Models.Movie>

@{
    ViewData["Title"] = "Filmer";
}

<h1>Filmer</h1>

<table class="table">
    <thead>
        <tr>
            <th>Titel</th>
            <th>År</th>
            <th>Speltid (min)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var movie in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@movie.Id">@movie.Title</a></td>
                <td>@movie.ReleaseYear</td>
                <td>@movie.RuntimeMinutes</td>
            </tr>
        }
    </tbody>
</table>